# Demo sign-in passwords for a LOCAL REGTEST setup only (play money).
# scripts/run-polar.sh copies this file to .env, which is git-ignored.
# Each must be at least 8 characters. Change them before showing the app to anyone.
ALICE_PASSWORD=alice-regtest-demo
BOB_PASSWORD=bob-regtest-demo
ADMIN_PASSWORD=admin-regtest-demo

# --- Sign in with Google (optional). Leave empty to keep it off. ---
# Create an "OAuth client ID" of type "Web application" in the Google Cloud console
# with the redirect URI  http://localhost:8080/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Which Google account gets which role. Only these accounts are let in.
ADMIN_EMAIL=
ALICE_EMAIL=
BOB_EMAIL=
